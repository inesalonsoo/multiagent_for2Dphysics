# Secrets: never commit
.env
.env.*
!.env.example

# Python
__pycache__/
*.pyc
.pytest_cache/
.venv/

# Data: raw trajectories are regenerated, not tracked
data/*
!data/.gitkeep

# Reference papers (third-party copyrighted PDFs: cite the arXiv URL in
# docs instead of redistributing a copy; kept locally, never tracked)
*.pdf

# Lemma workspace export (an external tool's working files, ~2 MB), kept
# locally; what was merged from it is recorded in docs/HISTORY.md
lemma-workspace-files.zip

# OS
.DS_Store
Thumbs.db
